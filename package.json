{
  "name": "fallz-kennel",
  "version": "0.7.6",
  "private": true,
  "description": "Gestão offline-first para o Fallz Kennel",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "release": "npm run build && electron-builder --win nsis",
    "release:portable": "npm run build && electron-builder --win portable",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "mobile:start": "pnpm --filter @fallz/mobile start",
    "mobile:android": "pnpm --filter @fallz/mobile android",
    "mobile:typecheck": "pnpm --filter @fallz/mobile typecheck",
    "core:test": "pnpm --filter @fallz/core test"
  },
  "dependencies": {
    "@fallz/core": "workspace:*",
    "@hookform/resolvers": "^5.2.2",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "firebase": "^12.3.0",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.fallzkennel.desktop",
    "productName": "Fallz Kennel",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "jpcostadev",
        "repo": "fallz-kennel"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "fallz-kennel.png",
      "artifactName": "Fallz-Kennel-Setup-${version}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fallz Kennel",
      "installerLanguages": [
        "pt_BR"
      ]
    }
  }
}
